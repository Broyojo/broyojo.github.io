\usepackage{enumitem}
\usepackage{fancyhdr}
\usepackage{titlesec}
\usepackage{tabularx}

% idk wtf this is but dont touch lol
\raggedright
\setlength{\tabcolsep}{0pt}

% Ensure PDF is ATS-parsable (pdftex only; xetex/luatex emit unicode natively)
\ifdefined\pdfgentounicode
    \input{glyphtounicode}
    \pdfgentounicode=1
\fi

% Header/footer styling
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}

% Sections styling (Education, Projects, etc.)
\titleformat{\section}{\scshape\large}{}{0pt}{}[\titlerule]
\titlespacing{\section}{0pt}{0.5\baselineskip}{0.5\baselineskip}

% [left-aligned bold text] <SPACE> [right-aligned italicized text] (Company, Location)
% [left-aligned text] <SPACE> [right-aligned text] (Position, Duration)
% \newcommand{\lrHeading}[4]{
%     \item[]
%     \begin{tabular*}{1\textwidth}{l@{\extracolsep{\fill}}r}
%         \textbf{#1} & \textit{#2} \\
%         \textit{#3} & {#4} \\
%     \end{tabular*}
%     \vspace{-1em}
% }

\newcommand{\lrHeading}[4]{
    \item[]
    \noindent
    \begin{tabularx}{\textwidth}{Xr}
        \textbf{#1}: \textit{#2} & #3 \\
    \end{tabularx}
    #4
    \vspace{-0.7em}
}

% [left-aligned bold text] <SPACE> [right-aligned text] (Title, Duration)
\newcommand{\lrLabel}[2]{
    \item[]
    \begin{tabular*}{1\textwidth}{l@{\extracolsep{\fill}}r}
        \textbf{#1} & #2
    \end{tabular*}
    \vspace{-1.2em}
}

% [bold text]: [plain text] (Coursework, Skills, etc.)
\newcommand{\labledItem}[2]{
    \item[]\small{\textbf{#1}{: #2}}
    % \vspace{-0.5em}
}

% Bullet point styling
\renewcommand{\labelitemii}{$\circ$}

% [bullet point] [plain text]
\newcommand{\bulletedItem}[1]{
    \item\small{#1}
}

% For plain items
\newcommand{\listStart}{\begin{itemize}[leftmargin=0em]}
\newcommand{\listEnd}{\end{itemize}}

% For bulleted items
\newcommand{\indentedListStart}{\begin{itemize}[leftmargin=1.5em]}
\newcommand{\indentedListEnd}{\end{itemize}\vspace{-0.5em}}